APP_NAME=Plumcert
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# ── MySQL / MariaDB ──────────────────────────────────────────────
# Set DB_CONNECTION=mysql (the mysql driver is fully MariaDB-compatible)
# and uncomment the lines below.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=plumcert
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Recommended: use redis for Horizon; falls back to database for SQLite-only environments
TELESCOPE_ENABLED=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# ── Gmail SMTP ───────────────────────────────────────────────────
# Use an App Password (Google Account → Security → 2-Step Verification
# → App passwords), NOT your normal Gmail password.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD="your-16-char-app-password"
# MAIL_FROM_ADDRESS="you@gmail.com"

# ── SMS / WhatsApp (Twilio) ──────────────────────────────────────
SMS_DRIVER=log
# SMS_DRIVER=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+447700900000
# TWILIO_WHATSAPP_FROM=+14155238886

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=localhost

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

OSM_USER_AGENT="plumcert-gas-safety/1.0"

HORIZON_PATH=horizon
